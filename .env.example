# PostgreSQL connection string (Supabase / Neon / local).
# Supabase: Connect -> Session pooler -> replace [YOUR-PASSWORD] with your password.
#   postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Neon:     postgresql://user:pass@ep-xxx.aws.neon.tech/genz?sslmode=require
DATABASE_URL="postgresql://postgres:Like87unlike@localhost:5432/genz?schema=public"
AUTH_SECRET=7356578b3c4ee66ead2c04b1167a71193c8b17ec1c65347a06c82e974e45bc22
ENCRYPTION_KEY=3002bb17b6510d18f2732c5f555ed2c6b2db00cb1f38a19501c0af8990da1917
SEED_ADMIN_EMAIL=admin@genzcafe.local
SEED_ADMIN_PASSWORD=drgames87
# Optional: direct (non-pooled) URL, used only by migrations on pooled providers.
# DIRECT_URL="postgresql://user:pass@ep-xxx.aws.neon.tech/genz?sslmode=require"

# Connections to a hosted database are always encrypted. By default the server
# certificate is not verified, which is what Supabase and Neon require out of the
# box. To turn on full verification, paste your provider's CA certificate here
# (Supabase: Project Settings -> Database -> SSL Configuration).
# DATABASE_SSL_CA=""

# Secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=""

# 32-byte key (64 hex chars) used for AES-256-GCM encryption of Aadhaar numbers
# and for the HMAC blind index. Generate with:
#   openssl rand -hex 32
# WARNING: changing this makes existing encrypted Aadhaar values unreadable.
ENCRYPTION_KEY=""

# Optional: seeds the first admin account when running `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@genzcafe.local"
SEED_ADMIN_PASSWORD="change-me-before-first-run"

